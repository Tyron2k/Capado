# Capado - Environment Variables
# Copy this file to .env and adjust the values.

# =============================================================================
# PostgreSQL (used by Docker Compose db service)
# =============================================================================

# Database superuser name for the PostgreSQL container.
# Format: alphanumeric string. Default: capado_user
POSTGRES_USER=capado_user

# Database superuser password for the PostgreSQL container.
# Format: any string. Required (no default).
POSTGRES_PASSWORD=

# Database name created on first container start.
# Format: alphanumeric/underscore string. Default: capado
POSTGRES_DB=capado

# Host port mapped to the PostgreSQL container port 5432.
# Format: integer (valid port number). Default: 5432
POSTGRES_PORT=5432

# =============================================================================
# Backend
# =============================================================================

# Deployment environment. In 'production' the backend refuses to start unless
# a strong JWT_SECRET_KEY is set (fail-fast). Outside production a random
# per-process secret is generated when JWT_SECRET_KEY is unset.
# Format: one of development | test | production. Default: development
ENVIRONMENT=development

# Host port mapped to the backend container port 3001.
# Format: integer (valid port number). Default: 3001
BACKEND_PORT=3001

# Async SQLAlchemy database connection URL used by the backend and Alembic.
# Format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# Default: postgresql+asyncpg://postgres:postgres@localhost:5432/capado
DATABASE_URL=postgresql+asyncpg://capado_user:${POSTGRES_PASSWORD}@db:5432/capado

# CORS: comma-separated list of allowed origins for cross-origin requests.
# Wildcard '*' is rejected (incompatible with credentialed requests) and falls
# back to the localhost defaults.
# Format: comma-separated URLs (e.g. http://localhost:3000,http://localhost:5173)
# Default: http://localhost:3000,http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Number of trusted reverse proxies in front of the backend. Controls how the
# client IP is derived from X-Forwarded-For for auth rate limiting. Set to 0
# when the app is directly exposed, so a client cannot spoof the header to
# bypass the limit. Set to the number of proxies (e.g. 1 behind Traefik/Nginx).
# Format: non-negative integer. Default: 0
TRUSTED_PROXY_COUNT=0

# Auth rate limiting: max requests per window per client IP, and window length.
# Format: positive integers. Defaults: 10 requests / 60 seconds
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

# Path to a tenant-specific work schedule JSON configuration file.
# When unset or pointing to a missing file, the built-in default
# (Mon-Fri 08:00-17:00, 60 min pause, 8h net) is used.
# Format: absolute file path to a JSON file. Default: unset (uses built-in default)
WORK_SCHEDULE_CONFIG_PATH=

# =============================================================================
# Authentication / JWT
# =============================================================================

# Secret key used to sign and verify JWT access/refresh tokens AND OIDC state
# cookies. IMPORTANT: With ENVIRONMENT=production the backend refuses to start
# unless this is set to a strong random value. Outside production a random
# secret is generated per process (tokens won't survive restarts and this is
# unsafe across multiple workers).
# Format: random string (min 32 characters recommended). Required for production.
JWT_SECRET_KEY=

# Algorithm used for JWT token signing.
# Format: JWT algorithm identifier. Allowed values: HS256, HS384, HS512. Default: HS256
JWT_ALGORITHM=HS256

# Lifetime of access tokens in minutes.
# Format: positive integer. Default: 15
ACCESS_TOKEN_EXPIRE_MINUTES=15

# Lifetime of refresh tokens in days.
# Format: positive integer. Default: 7
REFRESH_TOKEN_EXPIRE_DAYS=7

# bcrypt cost factor for password hashing. Higher is slower and more secure.
# Values below 10 are clamped to 10.
# Format: integer >= 10. Default: 12
BCRYPT_WORK_FACTOR=12

# Refresh-token cookie (httpOnly). The refresh token is transported in a
# cookie rather than JS-readable storage to reduce XSS exposure.
# SameSite=lax blocks the cookie on cross-site POSTs (CSRF defense) while
# allowing same-site XHR and the OIDC redirect.
# Format: one of lax | strict | none. Default: lax
REFRESH_COOKIE_SAMESITE=lax

# Force the Secure flag on the refresh cookie. When unset it is derived from
# ENVIRONMENT (Secure in production, not in development). Secure cookies
# require HTTPS.
# Format: true | false (leave empty to auto-derive). Default: (derived)
COOKIE_SECURE=

# Grace window (seconds) during which a just-rotated refresh token that is
# replayed is treated as a benign concurrent refresh (e.g. two browser tabs)
# rather than token theft. Outside this window, replay revokes all of the
# user's refresh tokens.
# Format: non-negative integer. Default: 10
REFRESH_REUSE_GRACE_SECONDS=10

# =============================================================================
# OIDC (optional single sign-on) — leave issuer/client empty to disable
# =============================================================================

# OIDC provider issuer base URL (used for discovery). Empty disables OIDC.
# Format: URL. Default: unset (OIDC disabled)
OIDC_ISSUER_URL=

# OIDC client credentials registered with the provider.
# Format: strings. Default: unset
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Redirect URI registered with the OIDC provider for the callback.
# Format: URL. Default: unset
OIDC_REDIRECT_URI=

# Space-separated OIDC scopes to request.
# Format: space-separated string. Default: openid email profile
OIDC_SCOPES=openid email profile

# Whether to auto-provision a local user on first successful OIDC login.
# Format: boolean (true/false). Default: false
OIDC_AUTO_CREATE_USERS=false

# Refuse an SSO login when the provider does not assert email_verified: true.
# The email claim is what links an SSO login to an EXISTING account — including an
# administrator's, keeping that role — so an unverified address is an account-takeover
# path rather than a convenience.
# Note this gate runs BEFORE the auto-create check above: OIDC_AUTO_CREATE_USERS=false
# does not protect the linking path, which is why this is a separate setting.
# Set to false only for a provider that omits the claim entirely and whose addresses you
# trust; the refusal is logged with the reason either way.
#
# AUTHENTIK USERS, READ THIS FIRST. Since authentik 2025.10 the built-in email scope
# mapping returns email_verified: FALSE by design — authentik's own docs say it "has no
# way to confirm whether a user's email is verified", and refuses to claim otherwise.
# So an unmodified authentik will have its logins refused here. Two honest fixes:
#   - set OIDC_REQUIRE_VERIFIED_EMAIL=false, which scopes the trust decision to Capado; or
#   - add a custom scope mapping in authentik that returns email_verified: true, which
#     tells EVERY application connected to it that you vouch for those addresses.
# Prefer the first unless you want the second's blast radius.
# Format: true | false. Default: true
OIDC_REQUIRE_VERIFIED_EMAIL=true

# Base URL of the frontend for the post-login redirect after OIDC callback.
# Format: URL. Default: http://localhost:5173
FRONTEND_URL=http://localhost:5173

# =============================================================================
# Frontend
# =============================================================================

# Host port mapped to the frontend container port 3000.
# Format: integer (valid port number). Default: 3000
FRONTEND_PORT=3000

# Base URL of the backend API used by the frontend Axios clients.
# Format: URL with protocol and port (e.g. http://localhost:3001). Default: http://localhost:3001
VITE_API_BASE_URL=http://localhost:3001

# =============================================================================
# Running the published images (docker-compose.prod.yml only)
# =============================================================================
#
# These are ignored by docker-compose.yml, which builds from source instead.

# Registry path the images are pulled from, without the trailing image name.
# Change this if you run your own fork's images.
# Format: <registry>/<owner>/<repo>. Default: ghcr.io/tyron2k/capado
CAPADO_IMAGE_PREFIX=ghcr.io/tyron2k/capado

# Image tag to run. A release publishes the full version plus the shortened
# forms and `latest` — so 0.1.0, 0.1, 0 and latest all exist after v0.1.0.
# Pin a version for anything you rely on: `latest` moves under you on the next
# release, including across a breaking change.
# Format: image tag. Default: latest
CAPADO_VERSION=latest

# The URL people actually open Capado at. Used for CORS and for links the
# backend generates, so a wrong value shows up as blocked API calls in the
# browser console rather than as a server error.
# Format: URL with protocol, no trailing slash. Default: http://localhost:3000
CAPADO_PUBLIC_URL=http://localhost:3000

# Trying Capado on plain HTTP at localhost? Set COOKIE_SECURE=false above.
# docker-compose.prod.yml runs with ENVIRONMENT=production, which makes the
# refresh cookie Secure — and a Secure cookie is never sent over http://, so
# the symptom is being logged out again on every page load. Leave it alone for
# any deployment that actually has TLS.
